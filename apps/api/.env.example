# Copie para apps/api/.env e preencha

# Porta da API
PORT=3001

# Origem do front liberada no CORS
ALLOWED_ORIGINS=http://localhost:3000

# Arquivo do banco SQLite
DB_PATH=./dev.db

# Segredo para assinar os tokens de login (gere um valor aleatório e longo).
# Sem ele, a API usa um segredo temporário e os logins caem a cada reinício.
AUTH_SECRET=

# Chaves dos provedores de IA (só a do provedor que você usar)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
